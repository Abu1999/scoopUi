{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScoopUI",
  "mainBinaryName": "ScoopUI",
  "version": "1.0.0",
  "identifier": "dev.scoopui.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ScoopUI",
        "width": 1200,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installerHooks": "nsis/installer-hooks.nsh",
        "installMode": "currentUser"
      },
      "wix": {
        "language": "zh-CN"
      }
    },
    "resources": ["resources/scoop-bundle.zip", "resources/scoop-bundle.json"],
    "shortDescription": "Scoop 包管理器的 Windows 桌面图形界面",
    "longDescription": "为 Scoop 打造的全功能桌面客户端：一体化环境初始化、应用与软件源管理、离线搜索、镜像与下载加速、配置集、环境迁移（Tauri 2 + Vue 3 + Rust）",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
